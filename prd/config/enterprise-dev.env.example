# Enterprise development / probe inputs. No real credentials in this template.
# Loading this file is explicit; Octop does not automatically import it.
# Plugin production credentials remain encrypted Host records via admin actions.

OCTOP_WEKNORA_BASE_URL=http://sncon.k9.luyouxia.net:44813
OCTOP_WEKNORA_VERSION=0.8.3
# Already set in this Windows user's environment. Do not paste the value here.
# OCTOP_WEKNORA_API_KEY is already configured; do not overwrite it with blank.
# Test-only exact-origin exception explicitly authorized by the user.
# Probe support passed P01b review; this is not a general HTTP switch.
OCTOP_WEKNORA_TEST_HTTP_ORIGIN=http://sncon.k9.luyouxia.net:44813
OCTOP_WEKNORA_IMAGE_DIGEST=
OCTOP_WEKNORA_CA_BUNDLE=
OCTOP_WEKNORA_TENANT_ID=10000
# Two comma-separated IDs each, once real indexed test resources are identified.
OCTOP_WEKNORA_TEST_KB_IDS=
OCTOP_WEKNORA_TEST_DOCUMENT_IDS=
OCTOP_WEKNORA_PROBE_QUERY=
OCTOP_WEKNORA_CONSUMER_IDENTITY=

