{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "typeRoots": ["../../../dashboard/node_modules/@types"],
    "baseUrl": ".",
    "paths": {
      "react": ["../../../dashboard/node_modules/@types/react/index.d.ts"],
      "react/jsx-runtime": ["../../../dashboard/node_modules/@types/react/jsx-runtime.d.ts"],
      "vitest": ["../../../dashboard/node_modules/vitest/dist/index.d.ts"],
      "@testing-library/react": ["../../../dashboard/node_modules/@testing-library/react/types/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vitest.config.ts"]
}
